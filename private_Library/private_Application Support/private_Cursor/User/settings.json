{
  "update.showReleaseNotes": false,
  "window.autoDetectColorScheme": true,
  "workbench.colorTheme": "Vitesse Dark",
  "workbench.preferredDarkColorTheme": "Vitesse Dark",
  "workbench.preferredLightColorTheme": "Vitesse Light Soft",
  "workbench.iconTheme": "file-icons",
  "workbench.productIconTheme": "icons-carbon",
  "editor.fontSize": 18,
  "editor.fontFamily": "'IBM Plex Mono', 'TX-02', 'Geist Mono Medium', 'Cascadia Code', Monaco, Menlo, 'Courier New', monospace",
  "editor.fontWeight": 400,
  "editor.minimap.enabled": false,
  "editor.fontLigatures": true,
  "workbench.fontAliasing": "antialiased",
  "window.zoomLevel": 0,
  "window.nativeTabs": true,
  "window.customTitleBarVisibility": "never",
  "window.titleBarStyle": "custom",
  "editor.stickyScroll.enabled": true,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.cursorBlinking": "solid",
  "editor.guides.bracketPairs": "active",
  "editor.wordWrap": "off",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.sideBar.location": "right",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.expandMode": "singleClick",
  "workbench.tree.indent": 10,
  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.tabActionLocation": "right",
  "files.simpleDialog.enable": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/*.tsbuildinfo": true,
    "**/Thumbs.db": true
  },
  "editor.tabSize": 2,
  "editor.renderWhitespace": "selection",
  "editor.guides.indentation": false,
  "editor.detectIndentation": true,
  "editor.snippetSuggestions": "inline",
  "editor.inlineSuggest.enabled": false,
  "editor.inlayHints.enabled": "off",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "editor.rulers": [80],
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#ff4081"
  },
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.enableMultiLinePasteWarning": "auto",
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.scrollback": 10000,
  "git.confirmSync": false,
  "git.autofetch": false,
  "git.suggestSmartCommit": false,
  "editor.unicodeHighlight.allowedLocales": {
    "ru": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "tsconfig.json": "tsconfig.*.json",
    "README*": "AUTHORS, BACKERS*, CITATION*, CODE_OF_CONDUCT*, CODEOWNERS, CONTRIBUTING*, CONTRIBUTORS, COPYING, CREDITS, GOVERNANCE.md, HISTORY.md, LICENSE*, MAINTAINERS, README*, SECURITY.md, SPONSORS*",
    "package.json": "package-lock.json, bun.lockb, bun.lock, pnpm-lock.yaml, pnpm-workspace.yaml"
  },
  "extensions.autoUpdate": false,
  "extensions.ignoreRecommendations": true,
  "codesnap.boxShadow": "none",
  "codesnap.showLineNumbers": false,
  "codesnap.showWindowControls": false,
  "codesnap.transparentBackground": true,
  "eslint.useFlatConfig": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.cpp.disabledLanguages": [
    "plaintext",
    "scminput"
  ],
  "editor.accessibilitySupport": "off",
  "diffEditor.maxComputationTime": 0,
  "diffEditor.ignoreTrimWhitespace": false,
  "eslint.useESLintClass": true,
  "json.schemaDownload.enable": true,
  "workbench.externalBrowser": "default",
  "files.associations": {
    "*.yml": "yaml",
    "*.mdc": "markdown"
  },
  "workbench.layoutControl.enabled": false
}
